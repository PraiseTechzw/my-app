{
  "expo": {
    "name": "FocusFlow",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/focusflow-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/focusflow-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF9",
        "foregroundImage": "./assets/images/focusflow-splash-mark.png",
        "monochromeImage": "./assets/images/focusflow-splash-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/focusflow-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF9",
          "image": "./assets/images/focusflow-splash-mark.png",
          "imageWidth": 104
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
